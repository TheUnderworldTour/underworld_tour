[sub_resource type="Shader" id="Shader_0wcw4"]
code = "shader_type spatial;

uniform vec4 base_color : source_color = vec4(0.28, 0.30, 0.23, 1.0);
uniform vec4 patch_color : source_color = vec4(0.17, 0.20, 0.14, 1.0);

uniform float patch_scale = 1.5;
uniform float grain_strength = 0.06;

varying vec3 local_position;


float random_value(vec2 point) {
	return fract(sin(dot(point, vec2(127.1, 311.7))) * 43758.5453);
}


float noise(vec2 point) {
	vec2 cell = floor(point);
	vec2 offset = fract(point);
	vec2 blend = offset * offset * (3.0 - 2.0 * offset);

	float a = random_value(cell);
	float b = random_value(cell + vec2(1.0, 0.0));
	float c = random_value(cell + vec2(0.0, 1.0));
	float d = random_value(cell + vec2(1.0, 1.0));

	return mix(
		mix(a, b, blend.x),
		mix(c, d, blend.x),
		blend.y
	);
}


void vertex() {
	local_position = VERTEX;
}


void fragment() {
	vec2 point = local_position.xz * patch_scale;

	float patches = noise(point) * 0.65;
	patches += noise(point * 2.3 + vec2(8.2, 3.7)) * 0.35;

	float grain = noise(point * 12.0) - 0.5;

	ALBEDO = clamp(
		mix(base_color.rgb, patch_color.rgb, patches)
		+ vec3(grain * grain_strength),
		vec3(0.0),
		vec3(1.0)
	);

	ROUGHNESS = 1.0;
}"

